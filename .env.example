# ---------- Database (Neon Postgres) ----------
# For Neon: use the *non-pooled* (direct) connection string here so that
# `prisma migrate` works. App runtime queries via Prisma Client are fine on
# the direct URL too for personal/low-traffic use. For Vercel production
# with heavy traffic, switch to the `-pooler` URL and add `?pgbouncer=true&connect_timeout=15`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---------- Auth.js v5 ----------
# 32+ byte random string. Generate with:
#   PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   Or: pnpm exec auth secret
AUTH_SECRET=""
# Set this only when deploying behind a proxy. Locally Auth.js v5 infers it.
# AUTH_URL="https://timepick.example.com"

# ---------- Google OAuth ----------
# Auth.js v5 auto-loads these env names for the Google provider.
# Initial login scope is openid email profile (set in OAuth consent screen).
# Calendar scopes (calendar.events, calendar.readonly) are requested later
# via incremental authorization from the in-app settings screen.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Access control (allowlist) ----------
# Comma-separated email addresses that are allowed to sign in.
# Leave empty to allow any Google account (e.g., after the app goes public).
ALLOWED_EMAILS="you@example.com,friend@example.com"
