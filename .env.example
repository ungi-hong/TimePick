# =========================================
# TimePick の環境変数テンプレート
# 本ファイルをコピーして .env.local (開発) / Vercel 環境変数 (本番) に値を入れる。
# 値はコミットしないこと。
# =========================================

# ---------- Database (Neon Postgres) ----------
# Neon ダッシュボードの接続文字列を貼る。
# - prisma migrate は direct connection 推奨 (pooler 経由だと preparedStatement が落ちる)
# - アプリ runtime は @prisma/adapter-neon + @neondatabase/serverless 経由で
#   サーバレス向けに動くので、pooler URL でも direct URL でも可。
# 例:
#   postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---------- Auth.js v5 ----------
# 32+ byte の random 文字列。環境ごとに別の値にする。
# 生成例:
#   PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   pnpm:       pnpm exec auth secret
AUTH_SECRET=""

# Vercel 上では自動検出されるので未設定で OK。
# ローカルや独自ホスティングでは設定する。
# AUTH_URL="https://timepick.example.com"

# プロキシ配下や Vercel preview を使う場合に必要。本番では通常 true。
AUTH_TRUST_HOST="true"

# ---------- Google OAuth ----------
# Auth.js v5 がこの env 名を自動で読む。
# 初回ログインのスコープは openid email profile (auth.config.ts で設定)。
# Calendar スコープ (calendar.events, calendar.readonly) は設定画面から
# incremental authorization で追加する。
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- アクセス制限 (allowlist) ----------
# カンマ区切りで許可メールを列挙する。空のままだと誰もログインできない (fail-closed)。
# 例:
#   ALLOWED_EMAILS="alice@example.com,bob@example.com"
ALLOWED_EMAILS=""

# 明示的に全公開モード (allowlist を無視して全 Google アカウントを許可) にする
# 場合のみ "true" にする。本番では基本的に未設定 / false を推奨。
# ALLOW_PUBLIC_SIGNUP="false"
